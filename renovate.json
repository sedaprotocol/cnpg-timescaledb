{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "UTC",
  "schedule": ["* 5-7 1,15 * *"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Pin TimescaleDB to 2.26.x: PR point releases, block 2.27+.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["timescale/timescaledb"],
      "allowedVersions": "/^2\\.26\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track TIMESCALE_VERSION in the Dockerfile.",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG TIMESCALE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "timescale/timescaledb",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track the TimescaleDB default in the build workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": [
        "TIMESCALE_VERSION: \\$\\{\\{ github\\.event\\.inputs\\.timescale_version \\|\\| '(?<currentValue>[0-9.]+)' \\}\\}"
      ],
      "depNameTemplate": "timescale/timescaledb",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
